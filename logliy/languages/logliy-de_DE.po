msgid "Password login is disabled. Use a Passkey or Email code instead."
msgstr "Passwort-Anmeldung ist deaktiviert. Nutzen Sie einen Passkey oder E-Mail-Code."

msgid "Password login is disabled for this account. Use a Passkey or Email code instead."
msgstr "Passwort-Anmeldung ist für dieses Konto deaktiviert. Nutzen Sie einen Passkey oder E-Mail-Code."

msgid "Please enter your email or username."
msgstr "Bitte geben Sie Ihre E-Mail-Adresse oder Ihren Benutzernamen ein."

msgid "If an account exists, a login code has been sent."
msgstr "Falls ein Konto existiert, wurde ein Anmeldecode gesendet."

msgid "Email code login is disabled."
msgstr "Anmeldung per E-Mail-Code ist deaktiviert."

msgid "Too many attempts. Please wait and try again."
msgstr "Zu viele Versuche. Bitte warten Sie und versuchen Sie es erneut."

msgid "Your login code for %s"
msgstr "Ihr Anmeldecode für %s"

msgid "Hi %1$s,\n\nYour login code for %2$s is:\n\n%3$s\n\nThis code expires in %4$d minutes. If you did not request it, you can ignore this email.\n\n— Logliy"
msgstr "Hallo %1$s,\n\nIhr Anmeldecode für %2$s lautet:\n\n%3$s\n\nDieser Code ist %4$d Minuten gültig. Wenn Sie ihn nicht angefordert haben, können Sie diese E-Mail ignorieren.\n\n— Logliy"

